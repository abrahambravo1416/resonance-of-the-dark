[sub_resource type="Shader" id="Shader_hiding_vignette"]
code = "shader_type canvas_item;
uniform vec4 shadow_tint : source_color = vec4(0.005, 0.012, 0.02, 0.5);
void fragment() {
    vec2 center = (UV - vec2(0.5)) * vec2(1.6, 2.0);
    float edge = smoothstep(0.18, 1.15, length(center));
    COLOR = vec4(shadow_tint.rgb, shadow_tint.a * (0.24 + 0.76 * edge)) * COLOR;
}"

